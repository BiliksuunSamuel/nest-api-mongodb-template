PORT=5858
CONNECTION_STRING=mongodb://localhost:27017/NestjsTemplate
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=365d
CORS_ORIGIN=*
APP_NAME=App
# country used for phone numbers written without a country code
DEFAULT_COUNTRY=GH
# days a signed-in session lasts; leave empty for no expiry
SESSION_LIFETIME_DAYS=
# set (e.g. 1) only when running behind a reverse proxy
TRUST_PROXY=
# app store review accounts: fixed code, no SMS. Leave empty to disable.
REVIEW_PHONES=
REVIEW_OTP_CODE=
